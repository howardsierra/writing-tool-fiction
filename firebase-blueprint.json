{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A user's project containing documents.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "customAuthors": { 
          "type": "array", 
          "items": { "type": "string", "maxLength": 50 },
          "maxLength": 10
        },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "Document": {
      "title": "Document",
      "description": "A document belonging to a project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 100000 },
        "type": { "type": "string", "enum": ["chapter", "scene", "character", "lore", "notes"] },
        "tags": {
          "type": "array",
          "items": { "type": "string", "maxLength": 50 },
          "maxLength": 20
        },
        "imageUrl": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["projectId", "userId", "title", "content", "type", "tags", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Stores user projects."
    },
    "/documents/{documentId}": {
      "schema": { "$ref": "#/entities/Document" },
      "description": "Stores documents for projects."
    }
  }
}
